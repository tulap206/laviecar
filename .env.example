NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT / internal APIs (generate a unique 32+ char secret for Laviecar)
INTERNAL_API_SECRET=your_32_char_internal_api_secret_here
NEXT_PUBLIC_INTERNAL_API_SECRET=your_32_char_internal_api_secret_here

# Optional: Vercel Cron authorization for /api/backup
CRON_SECRET=your_vercel_cron_secret_here

# Optional: privileged backup (falls back to anon key)
# SUPABASE_SERVICE_ROLE_KEY=
